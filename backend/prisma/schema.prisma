// Kirana Store App - Prisma Schema
// DB: Supabase (Postgres)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- ENUMS ----------

enum UserRole {
  CUSTOMER
  STAFF
  OWNER
  DELIVERY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PICKING
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COLLECTED
}

// ---------- CORE ----------

model Shop {
  id        String   @id @default(uuid())
  name      String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // Shop's own coordinates + delivery service radius, used to validate
  // customer addresses at signup (Haversine distance, no external geocoding
  // API — see backend/src/lib/geo.ts). Owner sets these from the dashboard.
  latitude         Float?
  longitude        Float?
  deliveryRadiusKm Float  @default(2)

  users    User[]
  products Product[]
  orders   Order[]
}

model User {
  id          String @id @default(uuid())
  shopId      String
  shop        Shop   @relation(fields: [shopId], references: [id])

  // Firebase Auth link for every role, including Customer — see
  // PROJECT_PROMPT.md "Customer identity trade-off" for the auth history.
  // Customers sign in with a username, mapped to a `username@internal.local`
  // Firebase email under the hood (never a real email) — same pattern
  // Staff/Owner use.
  firebaseUid String?  @unique
  name        String
  email       String?  @unique
  username    String?  @unique
  // Contact only, not an identifier — not unique, not required.
  mobile      String?
  houseNo     String?
  floorNo     String?
  area        String?
  // Customer's delivery coordinates, captured via on-device GPS and
  // validated against Shop.deliveryRadiusKm at signup. Null until the
  // address form is completed.
  latitude    Float?
  longitude   Float?
  role        UserRole

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  ordersAsCustomer Order[] @relation("CustomerOrders")
  ordersAsDelivery Order[] @relation("DeliveryOrders")

  @@index([shopId])
  @@index([shopId, role])
}

model Product {
  id     String @id @default(uuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  name        String
  description String?
  imageUrl    String? // Cloudinary URL
  price       Decimal @db.Decimal(10, 2)
  unit        String? // e.g. "kg", "pack", "pc"

  quantityAvailable Int     @default(0)
  isAvailable       Boolean @default(true)

  // Phase 2 (barcode) - kept nullable for now
  barcode String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]

  @@index([shopId])
  @@index([shopId, isAvailable])
}

model Order {
  id     String @id @default(uuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  customerId String
  customer   User   @relation("CustomerOrders", fields: [customerId], references: [id])

  deliveryBoyId String?
  deliveryBoy   User?   @relation("DeliveryOrders", fields: [deliveryBoyId], references: [id])

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  totalAmount   Decimal       @db.Decimal(10, 2)

  deliveryAddress String?
  notes           String?

  createdAt        DateTime  @default(now())
  confirmedAt       DateTime?
  packedAt          DateTime?
  outForDeliveryAt  DateTime?
  deliveredAt       DateTime?
  cancelledAt        DateTime?

  items OrderItem[]

  @@index([shopId, status])
  @@index([customerId])
  @@index([deliveryBoyId])
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity     Int
  priceAtOrder Decimal @db.Decimal(10, 2) // snapshot price at order time

  @@index([orderId])
  @@index([productId])
}
