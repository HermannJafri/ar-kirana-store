// Kirana Store App - Prisma Schema
// DB: Supabase (Postgres)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Supabase's pgbouncer/Supavisor pooler) — used for
  // all normal runtime queries.
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection — used only for `prisma migrate deploy`.
  // Pooled connections don't support the session-level advisory locking
  // Prisma migrations need, which is why `migrate deploy` hung on Render
  // (connected fine, then never completed). See PROJECT_PROMPT.md /
  // backend/.env.example for which URL goes where.
  directUrl = env("DIRECT_URL")
}

// ---------- ENUMS ----------

enum UserRole {
  CUSTOMER
  STAFF
  OWNER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

// Auto-computed from Order.amountPaid vs totalAmount, never set directly —
// see backend/src/routes/orders.ts's computePaymentStatus.
enum PaymentStatus {
  PENDING
  PARTIAL
  COLLECTED
}

// ---------- CORE ----------

model Shop {
  id        String   @id @default(uuid())
  name      String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // Shop's own coordinates + delivery service radius, used to validate
  // customer addresses at signup (Haversine distance, no external geocoding
  // API — see backend/src/lib/geo.ts). Owner sets these from the dashboard.
  latitude         Float?
  longitude        Float?
  deliveryRadiusKm Float  @default(2)

  users      User[]
  products   Product[]
  orders     Order[]
  categories Category[]
}

model Category {
  id        String   @id @default(uuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id])
  name      String
  createdAt DateTime @default(now())

  products Product[]

  @@unique([shopId, name])
  @@index([shopId])
}

model User {
  id          String @id @default(uuid())
  shopId      String
  shop        Shop   @relation(fields: [shopId], references: [id])

  // Firebase Auth link for every role, including Customer — see
  // PROJECT_PROMPT.md "Customer identity trade-off" for the auth history.
  // Staff/Owner sign in with a username; Customers sign in with their mobile
  // number (revised 2026-08-21). Both map to a synthetic
  // `<identifier>@internal.local` Firebase email under the hood (never a
  // real email).
  firebaseUid String?  @unique
  name        String
  email       String?  @unique
  // Optional for customers (Staff/Owner still use it to log in). Nullable
  // rather than DB-unique — see PROJECT_PROMPT.md; register route enforces
  // uniqueness in the app layer instead.
  username    String?  @unique
  // The customer login identifier (mandatory at registration, enforced in
  // the app layer rather than a DB constraint — see backend/src/routes/auth.ts).
  // Still optional/nullable here since Staff/Owner rows don't need it.
  mobile      String?
  houseNo     String?
  floorNo     String?
  area        String?
  // Customer's delivery coordinates, captured via on-device GPS and
  // validated against Shop.deliveryRadiusKm at signup. Null until the
  // address form is completed.
  latitude    Float?
  longitude   Float?
  role        UserRole

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  ordersAsCustomer Order[] @relation("CustomerOrders")

  @@index([shopId])
  @@index([shopId, role])
}

model Product {
  id     String @id @default(uuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  name        String
  description String?
  imageUrl    String? // Cloudinary URL
  price       Decimal @db.Decimal(10, 2)
  unit        String? // e.g. "kg", "pack", "pc"

  quantityAvailable Int     @default(0)
  isAvailable       Boolean @default(true)

  // Phase 2 (barcode) - kept nullable for now
  barcode String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]

  @@index([shopId])
  @@index([shopId, isAvailable])
}

model Order {
  id     String @id @default(uuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  customerId String
  customer   User   @relation("CustomerOrders", fields: [customerId], references: [id])

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  totalAmount   Decimal       @db.Decimal(10, 2)
  // Running total of cash physically brought back to the shop — recorded by
  // Owner/Staff from the dashboard, possibly across several partial
  // payments. paymentStatus is derived from this, never set directly.
  amountPaid    Decimal       @default(0) @db.Decimal(10, 2)

  deliveryAddress String?
  notes           String?

  createdAt        DateTime  @default(now())
  confirmedAt       DateTime?
  outForDeliveryAt  DateTime?
  deliveredAt       DateTime?
  cancelledAt        DateTime?

  items OrderItem[]

  @@index([shopId, status])
  @@index([customerId])
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity     Int
  priceAtOrder Decimal @db.Decimal(10, 2) // snapshot price at order time

  @@index([orderId])
  @@index([productId])
}
