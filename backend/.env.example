# Server
PORT=4000
NODE_ENV=development

# Supabase (Postgres) — from Supabase project settings
# DATABASE_URL: the pooled connection (port 6543, pgbouncer/Supavisor) —
#   used by the running app for all normal queries.
# DIRECT_URL: the direct, non-pooled connection (port 5432) — used only by
#   `prisma migrate deploy`. Pooled connections don't support the
#   session-level advisory locking migrations need; pointing migrate at the
#   pooler is what caused it to hang on Render (connected, then never
#   completed). Both are on the same Supabase project — copy them from
#   Project Settings → Database → Connection string ("Transaction"/pooled
#   for DATABASE_URL, "Session"/direct for DIRECT_URL).
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:PASSWORD@HOST:5432/postgres"
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"

# Firebase Admin SDK (server-side ID token verification)
FIREBASE_PROJECT_ID="replace-with-firebase-project-id"
FIREBASE_CLIENT_EMAIL="replace-with-service-account-client-email"
FIREBASE_PRIVATE_KEY="replace-with-service-account-private-key"

# Cloudinary (signed uploads — used by POST /uploads/product-image)
CLOUDINARY_CLOUD_NAME="replace-with-cloud-name"
CLOUDINARY_API_KEY="replace-with-api-key"
CLOUDINARY_API_SECRET="replace-with-api-secret"
