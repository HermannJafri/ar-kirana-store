# Server
PORT=4000
NODE_ENV=development

# Supabase (Postgres) — from Supabase project settings
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:5432/postgres"
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"

# Firebase Admin SDK (server-side ID token verification)
FIREBASE_PROJECT_ID="replace-with-firebase-project-id"
FIREBASE_CLIENT_EMAIL="replace-with-service-account-client-email"
FIREBASE_PRIVATE_KEY="replace-with-service-account-private-key"

# Cloudinary (signed uploads — used by POST /uploads/product-image)
CLOUDINARY_CLOUD_NAME="replace-with-cloud-name"
CLOUDINARY_API_KEY="replace-with-api-key"
CLOUDINARY_API_SECRET="replace-with-api-secret"
