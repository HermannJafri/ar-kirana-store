# Express backend — every read/write goes through here, never directly to
# Supabase or Cloudinary (see PROJECT_PROMPT.md, "Why every data access goes
# through the backend").
#
# On the Android emulator, "localhost" refers to the emulator itself, not
# your host machine — use 10.0.2.2 to reach a backend running on your host.
# On a real device, use your host machine's LAN IP instead.
API_BASE_URL=http://192.168.1.4:4000

# NOTE: Firebase config is NOT set here. On Android it's read natively from
# android/app/google-services.json (via the Google Services Gradle plugin),
# not from this .env file or a generated firebase_options.dart.
