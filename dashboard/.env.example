# Firebase Auth (client SDK config — owner/staff login).
# From Firebase Console → Project Settings → General → Your apps → Web app.
# NOTE: this is the public client config, safe to expose — a different value
# from the Admin SDK service account in backend/.env.
NEXT_PUBLIC_FIREBASE_API_KEY="replace-with-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="replace-with-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="replace-with-firebase-project-id"
NEXT_PUBLIC_FIREBASE_APP_ID="replace-with-firebase-app-id"

# Express backend — every read/write goes through here, never directly to
# Supabase or Cloudinary (see PROJECT_PROMPT.md, "Why every data access goes
# through the backend").
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
